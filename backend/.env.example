# MongoDB Atlas connection string
dbURL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?appName=Cluster0

# JWT Secret key (use a long random string in production)
jwt_secret=your_jwt_secret_key_here

# Razorpay Keys (test or live)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Your Vercel frontend URL (set this on Render)
# Example: https://shopkart.vercel.app
FRONTEND_URL=https://your-app.vercel.app

# Set to "production" on Render (enables secure cookies)
NODE_ENV=production
